<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#f8f1e7">
<title>دعوة زفاف عبد المجيد & آلاء</title>

<meta property="og:type" content="website">
<meta property="og:title" content="دعوة زفاف عبد المجيد & آلاء">
<meta property="og:description" content="السبت ٨ مايو ٢٠٢٧ · يسعدنا حضورك">
<meta property="og:image" content="https://YOUR-SITE.com/preview.jpg">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Cairo:wght@300;400;600&display=swap" rel="stylesheet">

<style>
:root{
  --bg:#f8f1e7;
  --paper:#f1e5d8;
  --ink:#3a1f26;
  --wine:#7a2b3a;
  --rose:#b98a7c;
  --muted:#8d7a74;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;background:var(--bg);color:var(--ink);
  font-family:'Cairo',sans-serif;font-weight:300;overflow-x:hidden;
}
button,input{font:inherit}
a{color:inherit;text-decoration:none}
::selection{background:var(--wine);color:#fff}

section{
  min-height:100svh;display:flex;flex-direction:column;
  align-items:center;justify-content:center;text-align:center;
  padding:80px 24px;position:relative;
}
.hero{background:radial-gradient(ellipse at 50% 30%,#fffaf2 0%,var(--bg) 70%)}
.hero:before{content:"";position:absolute;inset:16px;border:1px solid #b98a7c88;pointer-events:none}
.small{font-size:13px;letter-spacing:3px;color:var(--rose);font-weight:400}
h1{
  font:400 clamp(64px,15vw,150px)/1.25 'Amiri',serif;
  margin:28px 0 8px;color:var(--wine);
}
h1 i{display:block;font-style:normal;color:var(--rose);font-size:.32em;line-height:1.2}
.rule{width:1px;height:70px;background:var(--rose);margin:34px auto}
.date{font:400 clamp(20px,4vw,28px) 'Amiri',serif;letter-spacing:1px}
.place{color:var(--muted);margin-top:8px;font-size:15px}
.guest{color:var(--wine);font:22px 'Amiri',serif;margin-top:26px}
.guest:empty{display:none}

.soft{background:var(--paper)}
.verse{font:400 clamp(24px,4.5vw,36px)/2.2 'Amiri',serif;max-width:720px;color:var(--ink)}
.ref{color:var(--wine);font-size:13px;margin-top:20px;letter-spacing:1px}

.info{display:flex;gap:clamp(28px,8vw,80px);flex-wrap:wrap;justify-content:center}
.info div{min-width:110px}
.info b{display:block;font:400 13px 'Cairo';letter-spacing:3px;color:var(--rose);margin-bottom:10px}
.info span{font:400 26px/1.6 'Amiri',serif}
.count{margin-top:50px;color:var(--muted);font-size:15px}
.count strong{color:var(--wine);font:400 36px 'Amiri',serif;margin:0 6px}

.btn{
  display:inline-block;border:1px solid var(--wine);color:var(--wine);
  background:transparent;padding:13px 34px;margin:6px;cursor:pointer;
  font-weight:400;transition:.35s;border-radius:40px;
}
.btn:hover{background:var(--wine);color:#fff}
.btn.solid{background:var(--wine);color:#fff}
.btn.solid:hover{background:transparent;color:var(--wine)}
.actions{margin-top:44px}

h2{font:400 clamp(34px,6vw,52px) 'Amiri',serif;margin:0 0 30px}
.field{
  width:min(100%,340px);padding:14px 4px;background:transparent;
  border:0;border-bottom:1px solid #f8f1e799;color:inherit;
  text-align:center;outline:none;font-size:16px;
}
.field::placeholder{color:#d9c4c0}
.field:focus{border-color:#fff}

/* قسم تأكيد الحضور داكن */
.dark{background:var(--wine);color:var(--bg)}
.dark .btn{border-color:var(--bg);color:var(--bg)}
.dark .btn:hover{background:var(--bg);color:var(--wine)}
.dark .btn.solid{background:var(--bg);color:var(--wine)}
.dark .btn.solid:hover{background:transparent;color:var(--bg)}

footer{
  text-align:center;padding:36px 20px;color:var(--muted);
  font-size:12px;letter-spacing:2px;
}

 /* غلاف الدعوة */
#cover{
  position:fixed;inset:0;z-index:100;display:flex;flex-direction:column;
  align-items:center;justify-content:center;text-align:center;padding:24px;
  background:radial-gradient(ellipse at 50% 30%,#fffaf2 0%,var(--bg) 70%);
  transition:opacity 1s,visibility 1s;
}
#cover:before{content:"";position:absolute;inset:16px;border:1px solid #b98a7c88;pointer-events:none}
#cover.hide{opacity:0;visibility:hidden;pointer-events:none}
#cover h3{font:400 clamp(44px,11vw,80px)/1.3 'Amiri',serif;color:var(--wine);margin:18px 0 26px}
#cover .guest{margin:-8px 0 28px}

/* زر الموسيقى */
.music{
  position:fixed;bottom:20px;left:20px;z-index:60;
  width:46px;height:46px;border-radius:50%;
  border:1px solid var(--wine);background:#f8f1e7ee;color:var(--wine);
  font-size:20px;cursor:pointer;transition:.3s;
  box-shadow:0 6px 20px #7a2b3a22;
}
.music.on{background:var(--wine);color:#fff;animation:pulse 2.4s ease-in-out infinite}
.music.off{opacity:.7;text-decoration:line-through}
@keyframes pulse{0%,100%{box-shadow:0 0 0 0 #7a2b3a55}50%{box-shadow:0 0 0 10px #7a2b3a00}}

.reveal{opacity:0;transform:translateY(24px);transition:opacity 1.2s ease,transform 1.2s ease}
.reveal.on{opacity:1;transform:none}
#toast{
  position:fixed;top:20px;left:50%;transform:translateX(-50%);z-index:70;
  background:#fff;border:1px solid var(--wine);color:var(--ink);
  padding:12px 22px;font-size:13px;opacity:0;transition:opacity .4s;
  pointer-events:none;width:max-content;max-width:90%;text-align:center;border-radius:30px;
}
#toast.show{opacity:1}

@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .reveal{opacity:1;transform:none;transition:none}
  .music.on{animation:none}
  #cover{transition:none}
}
</style>
</head>
<body>

<div id="cover">
  <div class="small">دعوة زفاف</div>
  <h3>عبد المجيد & آلاء</h3>
  <div class="guest" id="coverGuest"></div>
  <button class="btn solid" id="openBtn">افتح الدعوة ♪</button>
</div>

<div id="toast"></div>

<audio id="bgm" loop preload="auto" src="music.mp3"></audio>

<button id="music" class="music off" aria-label="تشغيل أو إيقاف الموسيقى">♪</button>

<section class="hero reveal">
  <div class="small">ندعوكم لحضور حفل زفاف</div>
  <h1>عبد المجيد<i>&</i>آلاء</h1>
  <div class="rule"></div>
  <div class="date">السبت · ٨ مايو ٢٠٢٧</div>
  <div class="place">التاسعة مساءً · قاعة الماسة للحفلات</div>
  <div class="guest" id="guest"></div>
</section>

<section class="soft reveal">
  <div class="verse">
    ﴿ وَمِنْ آيَاتِهِ أَنْ خَلَقَ لَكُم مِّنْ أَنْفُسِكُمْ أَزْوَاجًا لِّتَسْكُنُوا إِلَيْهَا وَجَعَلَ بَيْنَكُم مَّوَدَّةً وَرَحْمَةً ﴾
  </div>
  <div class="ref">سورة الروم · ٢١</div>
</section>

<section class="reveal">
  <div class="info">
    <div><b>التاريخ</b><span>السبت<br>٨ مايو ٢٠٢٧</span></div>
    <div><b>الساعة</b><span>التاسعة<br>مساءً</span></div>
    <div><b>المكان</b><span>قاعة الماسة<br>للحفلات</span></div>
  </div>
  <div class="count"><strong id="days">—</strong> يوم على الفرحة</div>
  <div class="actions">
    <a class="btn solid" target="_blank" rel="noopener" href="https://maps.app.goo.gl/MJpTzhr6jtCYiH8M8">الموقع على الخريطة</a>
    <button class="btn" onclick="downloadICS()">أضف للتقويم</button>
  </div>
</section>

<section class="dark reveal">
  <h2>هل ستكون معنا؟</h2>
  <input class="field" id="name" placeholder="اسمك">
  <div class="actions" style="margin-top:36px">
    <button class="btn solid" onclick="sendRSVP(true)">سأحضر بإذن الله</button>
    <button class="btn" onclick="sendRSVP(false)">أعتذر عن الحضور</button>
  </div>
</section>

<footer>عبد المجيد & آلاء · ٢٠٢٧</footer>

<script>
const WHATSAPP_NUMBER = "201060708913";
const weddingDate = new Date(2027, 4, 8, 21, 0, 0);
const $ = id => document.getElementById(id);

/* اسم الضيف من الرابط: ?guest=أحمد */
try{
  const g = (new URLSearchParams(location.search).get("guest") || "").trim().slice(0,40);
  if(g){
    $("guest").textContent = "دعوة خاصة لـ " + g;
    $("coverGuest").textContent = "إلى " + g;
    $("name").value = g;
  }
}catch(e){}

/* عدد الأيام المتبقية */
const left = Math.ceil((weddingDate - new Date()) / 86400000);
$("days").textContent = left > 0 ? left : "0";

function toast(m){
  const t = $("toast");
  t.textContent = m;
  t.classList.add("show");
  clearTimeout(toast.t);
  toast.t = setTimeout(()=>t.classList.remove("show"), 3500);
}

/* تأكيد الحضور عبر واتساب */
function sendRSVP(attending){
  const name = $("name").value.trim();
  if(!name){ toast("من فضلك اكتب اسمك أولًا"); $("name").focus(); return; }
  const msg = attending
    ? `السلام عليكم ❤️\nأنا ${name}، وأؤكد حضوري بإذن الله.\nألف مبروك يا عبد المجيد وآلاء 🤍`
    : `السلام عليكم ❤️\nأنا ${name}، أعتذر للأسف عن عدم الحضور.\nألف مبروك، وربنا يتمم لكم على خير 🤍`;
  window.open(`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(msg)}`, "_blank", "noopener");
}

/* إضافة للتقويم (ملف ics يعمل على آيفون وأندرويد) */
function downloadICS(){
  const lines = [
    "BEGIN:VCALENDAR","VERSION:2.0","PRODID:-//AA Wedding//AR",
    "BEGIN:VEVENT","UID:aa-wedding-20270508@invitation","DTSTAMP:20260101T000000Z",
    "DTSTART:20270508T210000","DTEND:20270509T010000",
    "SUMMARY:زفاف عبد المجيد و آلاء","LOCATION:قاعة الماسة للحفلات",
    "BEGIN:VALARM","TRIGGER:-P1D","ACTION:DISPLAY","DESCRIPTION:زفاف عبد المجيد و آلاء بكرة","END:VALARM",
    "END:VEVENT","END:VCALENDAR"
  ];
  const url = URL.createObjectURL(new Blob([lines.join("\r\n")], {type:"text/calendar;charset=utf-8"}));
  const a = document.createElement("a");
  a.href = url; a.download = "wedding.ics";
  document.body.appendChild(a); a.click(); a.remove();
  setTimeout(()=>URL.revokeObjectURL(url), 1500);
}

/* الموسيقى الخلفية: لحن هادئ مُولَّد بالكود (لا يحتاج ملف صوت) */
const mbtn = $("music");
let ac, bus, master, timer, nextT = 0, step = 0, playing = false, autoPaused = false, tried = false;

/* أربع كوردات هادئة: Am – F – C – G */
const CHORDS = [
  [220.00, 261.63, 329.63],
  [174.61, 220.00, 261.63],
  [261.63, 329.63, 392.00],
  [196.00, 246.94, 293.66]
];
const PATTERN = [0,1,2,1,2,1,0,2];
const BAR = 6;

function initAudio(){
  ac = new (window.AudioContext || window.webkitAudioContext)();
  master = ac.createGain(); master.gain.value = 0;
  const lp = ac.createBiquadFilter(); lp.type = "lowpass"; lp.frequency.value = 2400;
  const delay = ac.createDelay(1.5); delay.delayTime.value = 0.46;
  const fb = ac.createGain(); fb.gain.value = 0.42;
  const wet = ac.createGain(); wet.gain.value = 0.38;
  lp.connect(master); lp.connect(delay);
  delay.connect(fb); fb.connect(delay);
  delay.connect(wet); wet.connect(master);
  master.connect(ac.destination);
  bus = lp;
}

function tone(freq, t, dur, type, vol, attack){
  const o = ac.createOscillator(), g = ac.createGain();
  o.type = type; o.frequency.value = freq;
  g.gain.setValueAtTime(0.0001, t);
  g.gain.linearRampToValueAtTime(vol, t + attack);
  g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
  o.connect(g); g.connect(bus);
  o.start(t); o.stop(t + dur + 0.05);
}

function playBar(t, idx){
  const c = CHORDS[idx];
  c.forEach(f => {                       /* بساط ناعم */
    tone(f,       t, BAR + 1.5, "sine", 0.045, 1.6);
    tone(f * 1.004, t, BAR + 1.5, "sine", 0.03, 1.8);
  });
  tone(c[0] / 2, t, BAR, "sine", 0.09, 0.8);   /* باص */
  PATTERN.forEach((n, k) => {            /* نغمات متقطعة رقيقة */
    tone(c[n] * 2, t + k * (BAR / 8), 2.4, "triangle", 0.07, 0.02);
  });
}

function schedule(){
  while(nextT < ac.currentTime + 1.5){
    playBar(nextT, step % 4);
    nextT += BAR; step++;
  }
}

function setMusic(on){ mbtn.classList.toggle("on", on); mbtn.classList.toggle("off", !on); }

async function playSynth(){
  try{
    if(!ac){ initAudio(); nextT = 0; }
    await ac.resume();
    if(nextT < ac.currentTime) nextT = ac.currentTime + 0.1;
    schedule();
    clearInterval(timer);
    timer = setInterval(schedule, 500);
    master.gain.cancelScheduledValues(ac.currentTime);
    master.gain.setTargetAtTime(0.8, ac.currentTime, 0.8);
    playing = true; setMusic(true);
  }catch(e){ setMusic(false); }
}

function stopSynth(){
  if(!ac) return;
  playing = false; setMusic(false);
  master.gain.cancelScheduledValues(ac.currentTime);
  master.gain.setTargetAtTime(0, ac.currentTime, 0.25);
  clearInterval(timer);
  setTimeout(()=>{ if(!playing) ac.suspend(); }, 1200);
}

/* الأولوية لملف music.mp3 (أغنية الدعوة)، ولو مش موجود يشتغل اللحن المولَّد */
const bgm = $("bgm");
let useFile = true, opened = false;

async function playMusic(){
  if(useFile){
    try{
      bgm.volume = 0.8;
      await bgm.play();
      playing = true; setMusic(true);
      return;
    }catch(e){
      if(e && e.name === "NotAllowedError"){ setMusic(false); return; }
      useFile = false;
    }
  }
  await playSynth();
}

function stopMusic(){
  if(useFile){ bgm.pause(); playing = false; setMusic(false); }
  else stopSynth();
}

bgm.addEventListener("error", ()=>{
  if(useFile){ useFile = false; if(opened) playSynth(); }
});

mbtn.addEventListener("click", ()=>{
  playing ? stopMusic() : playMusic();
});

/* فتح الغلاف: أول لمسة تشغّل الموسيقى فورًا */
$("openBtn").addEventListener("click", ()=>{
  opened = true;
  $("cover").classList.add("hide");
  window.scrollTo(0,0);
  playMusic();
});

document.addEventListener("visibilitychange", ()=>{
  if(document.hidden && playing){
    useFile ? bgm.pause() : ac.suspend();
    autoPaused = true;
  }else if(!document.hidden && autoPaused){
    useFile ? bgm.play().catch(()=>{}) : ac.resume();
    autoPaused = false;
  }
});

/* ظهور هادئ للأقسام */
const io = new IntersectionObserver(es=>{
  es.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add("on"); io.unobserve(e.target); } });
},{threshold:.2});
document.querySelectorAll(".reveal").forEach(el=>io.observe(el));
</script>
</body>
</html>
